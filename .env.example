# Copy to .env and adjust before deploying to VPS
# Only port 7554 (CineBook UI) is publicly exposed.
# All other services bind to 127.0.0.1.

# ── Operate (Camunda workflow monitor) ──────────────────────────────────────
# Accessible via SSH tunnel ONLY — not public.
# Tunnel:  ssh -L 18081:localhost:18081 user@your-vps
# Open:    http://localhost:18081
# Login:   username=admin
OPERATE_ADMIN_PASSWORD=Admin@Operate2025!
OPERATE_PORT=18081

# ── Version pins (change only when upgrading) ────────────────────────────────
# ELASTIC_VERSION=8.19.16
# CAMUNDA_ZEEBE_VERSION=8.9.9
# CAMUNDA_OPERATE_VERSION=8.9.9
